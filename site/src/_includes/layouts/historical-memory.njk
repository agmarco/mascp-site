---
layout: layouts/base.njk
---

{% if heroImage %}
<section class="hero-section min-h-[350px] md:min-h-[450px]" style="background-image: url('{{ heroImage }}');"></section>
{% else %}
<div class="bg-mascp-dark py-8">
  <h1 class="text-3xl md:text-4xl font-heading text-center text-white">{{ title }}</h1>
</div>
{% endif %}

<article class="prose max-w-4xl mx-auto px-4 md:px-8 py-8">
  {{ content | safe }}
</article>

{% if galleryImage1 %}
<section class="py-8 px-4">
  <div style="width: 1000px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
      {% if galleryImage1 %}<img src="{{ galleryImage1 }}" alt="" style="width: 100%; height: 260px; object-fit: cover; border-radius: 4px;">{% endif %}
      {% if galleryImage2 %}<img src="{{ galleryImage2 }}" alt="" style="width: 100%; height: 260px; object-fit: cover; border-radius: 4px;">{% endif %}
      {% if galleryImage3 %}<img src="{{ galleryImage3 }}" alt="" style="width: 100%; height: 260px; object-fit: cover; border-radius: 4px;">{% endif %}
      {% if galleryImage4 %}<img src="{{ galleryImage4 }}" alt="" style="width: 100%; height: 260px; object-fit: cover; border-radius: 4px;">{% endif %}
      {% if galleryImage5 %}<img src="{{ galleryImage5 }}" alt="" style="width: 100%; height: 260px; object-fit: cover; border-radius: 4px;">{% endif %}
      {% if galleryImage6 %}<img src="{{ galleryImage6 }}" alt="" style="width: 100%; height: 260px; object-fit: cover; border-radius: 4px;">{% endif %}
    </div>
  </div>
</section>
{% endif %}
