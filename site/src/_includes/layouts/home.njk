---
layout: layouts/base.njk
---

<!-- Rotating Banners -->
{% if banners and banners.length %}
<section class="py-8 bg-white">
  <div class="max-w-3xl mx-auto px-4">
    <div class="banner-carousel relative overflow-hidden rounded-lg shadow-lg">
      {% for banner in banners %}
      <div class="banner-slide {% if loop.first %}is-active{% endif %}" data-index="{{ loop.index0 }}">
        {% if banner.type == 'image' %}
          {% if banner.linkUrl %}
          <a href="{{ banner.linkUrl }}"{% if banner.linkUrl.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>
            <img src="{{ banner.image }}" alt="{{ banner.alt or 'MASCP event banner' }}" class="w-full h-auto">
          </a>
          {% else %}
          <img src="{{ banner.image }}" alt="{{ banner.alt or 'MASCP event banner' }}" class="w-full h-auto">
          {% endif %}
          {% if banner.links and banner.links.length %}
          <div class="flex flex-col sm:flex-row gap-3 justify-center py-5 px-6 bg-mascp-light">
            {% for link in banner.links %}
            <a href="{{ link.url }}" class="btn-primary inline-block text-center">{{ link.label }}</a>
            {% endfor %}
          </div>
          {% endif %}
        {% else %}
        <div class="bg-mascp-light px-6 py-10 md:px-12 md:py-14 text-center">
          {% if banner.logo %}<img src="{{ banner.logo }}" alt="{{ banner.logoAlt or 'U.S.-El Salvador Sister Cities' }}" class="h-16 md:h-20 w-auto mx-auto mb-4">{% endif %}
          {% if banner.eyebrow %}<p class="text-lg md:text-xl font-heading text-mascp-terracotta mb-2">{{ banner.eyebrow }}</p>{% endif %}
          {% if banner.title %}<h2 class="text-2xl md:text-3xl font-heading text-mascp-dark mb-4">&ldquo;{{ banner.title }}&rdquo;</h2>{% endif %}
          {% if banner.details %}<p class="text-lg text-mascp-gray mb-4 leading-relaxed">{{ banner.details | safe }}</p>{% endif %}
          {% if banner.linkUrl %}
          <a href="{{ banner.linkUrl }}" target="_blank" rel="noopener" class="btn-primary inline-block">{{ banner.linkText or 'More Info' }}</a>
          {% endif %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% if banners.length > 1 %}
    <div class="flex justify-center gap-2 mt-4">
      {% for banner in banners %}
      <button type="button" class="banner-dot w-2.5 h-2.5 rounded-full bg-mascp-gray/40 {% if loop.first %}is-active{% endif %}" data-index="{{ loop.index0 }}" aria-label="Show banner {{ loop.index }}"></button>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<style>
  .banner-slide { display: none; }
  .banner-slide.is-active { display: block; animation: mascp-banner-fade 0.5s ease; }
  .banner-dot.is-active { background-color: #C4533A; }
  @keyframes mascp-banner-fade { from { opacity: 0; } to { opacity: 1; } }
</style>
{% if banners.length > 1 %}
<script>
  (function () {
    var slides = document.querySelectorAll('.banner-slide');
    var dots = document.querySelectorAll('.banner-dot');
    var current = 0;
    var timer;

    function show(index) {
      current = index;
      slides.forEach(function (slide, i) { slide.classList.toggle('is-active', i === index); });
      dots.forEach(function (dot, i) { dot.classList.toggle('is-active', i === index); });
    }

    function startTimer() {
      timer = setInterval(function () { show((current + 1) % slides.length); }, 7000);
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        clearInterval(timer);
        show(parseInt(dot.getAttribute('data-index'), 10));
        startTimer();
      });
    });

    startTimer();
  })();
</script>
{% endif %}
{% endif %}

<!-- Welcome Section -->
<section class="content-section text-center">
  {% if welcomeHeading %}
  <h2 class="text-3xl md:text-4xl font-heading text-mascp-dark mb-6">{{ welcomeHeading }}</h2>
  {% endif %}
  <p class="text-lg text-mascp-gray max-w-3xl mx-auto leading-relaxed">
    {{ welcome | safe }}
  </p>
  <a href="/contact/" class="btn-primary inline-block mt-8">Contact Us For More Info</a>
</section>

<!-- Additional content -->
{{ content | safe }}

<!-- Call to Action -->
<section class="bg-mascp-light py-16">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h3 class="text-2xl font-heading mb-4">Support Our Work</h3>
    <p class="text-mascp-gray mb-6">Your donation helps us continue building solidarity between Madison and Arcatao.</p>
    <a href="/donate/" class="btn-primary inline-block">Donate Now</a>
  </div>
</section>
