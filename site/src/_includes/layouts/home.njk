---
layout: layouts/base.njk
---

<!-- Featured Image/Flyer -->
{% if heroImage %}
<section class="py-8 bg-white">
  <div class="max-w-3xl mx-auto px-4">
    {% if heroLink %}
    <a href="{{ heroLink }}" aria-label="View invitation and RSVP for the MASCP Pupusa Dinner and 40th Anniversary Celebration">
      <img src="{{ heroImage }}" alt="Invitation: MASCP Pupusa Dinner and 40th Anniversary Celebration. Saturday, August 22, 5:00 to 7:30pm. Aubergine, 1226 Williamson Street, Madison. Featuring a 40 Years of Sistering slideshow, Salvadoran music, and silent auction. Sliding scale suggested donation $4 to $40. Everyone welcome. Wheelchair accessible." class="w-full h-auto rounded-lg shadow-lg">
    </a>
    <p class="sr-only">
      MASCP Pupusa Dinner and 40th Anniversary Celebration.
      Saturday, August 22, 5:00 to 7:30pm at Aubergine, 1226 Williamson Street, Madison.
      Please join us as we joyfully celebrate 40 years of sistering and hear back from our most recent delegations to El Salvador.
      Featuring a 40 Years of Sistering slideshow, Salvadoran music, and silent auction.
      Sliding scale suggested donation: $4 to $40. Everyone welcome.
      Accessibility: Wheelchair accessible. Please allow time for neighborhood street parking. Bike parking across the street. Nearby buses: A, B, C and 38.
    </p>
    {% else %}
    <img src="{{ heroImage }}" alt="Visit Arcatao - Madison's Sister City in El Salvador" class="w-full h-auto rounded-lg shadow-lg">
    {% endif %}
    {% if heroCaption %}
    <p class="text-sm text-mascp-gray text-center mt-3 italic">{{ heroCaption }}</p>
    {% endif %}
    {% if heroLink %}
    <div class="flex flex-col sm:flex-row gap-3 justify-center mt-6">
      <a href="{{ heroLink }}" class="btn-primary inline-block text-lg px-8 py-3">RSVP Now &rarr;</a>
      <a href="/invite/" class="btn-secondary inline-block text-lg px-8 py-3">Invite a Friend</a>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<!-- Welcome Section -->
<section class="content-section text-center">
  {% if welcomeHeading %}
  <h2 class="text-3xl md:text-4xl font-heading text-mascp-dark mb-6">{{ welcomeHeading }}</h2>
  {% endif %}
  <p class="text-lg text-mascp-gray max-w-3xl mx-auto leading-relaxed">
    {{ welcome | safe }}
  </p>
  <a href="/contact/" class="btn-primary inline-block mt-8">Contact Us For More Info</a>
</section>

<!-- Additional content -->
{{ content | safe }}

<!-- Call to Action -->
<section class="bg-mascp-light py-16">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h3 class="text-2xl font-heading mb-4">Support Our Work</h3>
    <p class="text-mascp-gray mb-6">Your donation helps us continue building solidarity between Madison and Arcatao.</p>
    <a href="/donate/" class="btn-primary inline-block">Donate Now</a>
  </div>
</section>
