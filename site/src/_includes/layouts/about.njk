---
layout: layouts/base.njk
---

{% if heroImage %}
<section class="hero-section min-h-[450px] md:min-h-[550px]" style="background-image: url('{{ heroImage }}');"></section>
{% endif %}

<section class="bg-mascp-light">
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-12">
    <div class="md:flex md:gap-8 items-start">
      <div class="md:w-2/5 mb-6 md:mb-0">
        {% if sectionImage %}
        <img src="{{ sectionImage }}" alt="Community gathering in Arcatao" class="rounded-lg shadow-md w-full">
        {% endif %}
      </div>
      <div class="md:w-3/5">
        <h2 class="text-2xl md:text-3xl font-heading text-mascp-dark mb-6">OUR MISSION</h2>
        <p class="text-base md:text-lg leading-relaxed text-mascp-dark">{{ missionText }}</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">
    <h2 class="text-2xl md:text-3xl font-heading text-mascp-dark mb-6">ABOUT MASCP</h2>
    <div class="text-base md:text-lg leading-relaxed text-mascp-dark prose max-w-none">
      {{ aboutText | markdownify | safe }}
    </div>
  </div>
</section>

<section class="bg-mascp-light">
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">
    <h2 class="text-2xl md:text-3xl font-heading text-mascp-dark mb-6">ABOUT OUR NETWORK</h2>
    <div class="text-base md:text-lg leading-relaxed text-mascp-dark prose max-w-none">
      {{ networkText | markdownify | safe }}
    </div>
    <a href="https://uselsalvadorsistercities.org/" target="_blank" rel="noopener" class="btn-primary inline-block mt-6">Learn More About USESSC</a>
  </div>
</section>
