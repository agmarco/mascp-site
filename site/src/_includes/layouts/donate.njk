---
layout: layouts/base.njk
---

{% if heroImage %}
<section class="hero-section min-h-[350px] md:min-h-[450px]" style="background-image: url('{{ heroImage }}');"></section>
{% endif %}

<section class="bg-white py-12 md:py-16">
  <div class="max-w-4xl mx-auto px-4 md:px-8">
    <div class="mb-8">
      {% if donateHeading %}
      <h1 class="text-2xl md:text-3xl font-light text-mascp-dark mb-6 leading-tight">{{ donateHeading | upper }}</h1>
      {% endif %}
      {% if donateSubheading %}
      <p class="text-xl font-light text-mascp-dark mb-8">{{ donateSubheading }}</p>
      {% endif %}
    </div>

    {% if paypalButtonId %}
    <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top" class="mb-12">
      <input type="hidden" name="cmd" value="_s-xclick">
      <input type="hidden" name="hosted_button_id" value="{{ paypalButtonId }}">
      <button type="submit" style="background-color: #5ba8b6; color: white; padding: 12px 32px; font-size: 18px; font-weight: 500; border: none; cursor: pointer; display: inline-block;">
        Donate Now
      </button>
    </form>
    {% endif %}

    <article class="prose prose-lg max-w-none text-mascp-dark">
      {{ content | safe }}
    </article>
  </div>
</section>
