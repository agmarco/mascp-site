---
layout: layouts/base.njk
---

<section class="bg-white">
  <div class="max-w-2xl mx-auto px-4 md:px-8 py-12">

    <!-- Event header -->
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-mascp-terracotta mb-4">{{ eventName }}</h1>
      <p class="text-xl font-semibold text-mascp-dark">{{ eventDate }}</p>
      <p class="text-lg text-mascp-gray">{{ eventTime }}</p>
      <p class="text-lg text-mascp-gray">{{ eventVenue }}</p>
      <div class="border-b-2 border-mascp-terracotta w-24 mx-auto mt-6"></div>
    </div>

    <!-- RSVP Form -->
    <div id="rsvp-form-wrap">
      <form
        id="rsvp-form"
        name="rsvp-pupusa-dinner"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="rsvp-pupusa-dinner">
        <input type="hidden" name="event" value="{{ eventName }}">
        <p class="hidden"><input name="bot-field"></p>

        <div>
          <label for="rsvp-name" class="block text-base font-bold text-mascp-dark mb-2">Full Name <span class="text-mascp-terracotta">*</span></label>
          <input
            type="text"
            id="rsvp-name"
            name="name"
            required
            placeholder="Your full name"
            class="w-full px-4 py-4 border border-gray-400 text-lg font-semibold text-mascp-dark focus:outline-none focus:border-mascp-terracotta"
          >
        </div>

        <div>
          <label for="rsvp-email" class="block text-base font-bold text-mascp-dark mb-2">Email <span class="text-mascp-terracotta">*</span></label>
          <input
            type="email"
            id="rsvp-email"
            name="email"
            required
            placeholder="your@email.com"
            class="w-full px-4 py-4 border border-gray-400 text-lg font-semibold text-mascp-dark focus:outline-none focus:border-mascp-terracotta"
          >
        </div>

        <div>
          <label for="rsvp-guests" class="block text-base font-bold text-mascp-dark mb-2">Number of Attendees <span class="text-mascp-terracotta">*</span></label>
          <input
            type="number"
            id="rsvp-guests"
            name="guests"
            required
            min="1"
            value="1"
            class="w-full px-4 py-4 border border-gray-400 text-lg font-semibold text-mascp-dark focus:outline-none focus:border-mascp-terracotta"
          >
          <p class="text-sm text-mascp-gray mt-1">Include yourself in the total count.</p>
        </div>

        <div>
          <label for="rsvp-donation" class="block text-base font-bold text-mascp-dark mb-2">Donation Amount ($)</label>
          <input
            type="number"
            id="rsvp-donation"
            name="donation"
            min="0"
            value="40"
            class="w-full px-4 py-4 border border-gray-400 text-lg font-semibold text-mascp-dark focus:outline-none focus:border-mascp-terracotta"
          >
          <p class="text-sm text-mascp-gray mt-1">Sliding scale suggested: $4–$40. Enter 0 to attend without donating.</p>
        </div>

        <button
          type="submit"
          class="w-full bg-mascp-terracotta text-white px-4 py-4 text-lg font-medium hover:opacity-90 transition"
        >
          Click to Reserve Your Places
        </button>
      </form>
    </div>

    <!-- Success message (hidden until form submits) -->
    <div id="rsvp-success" class="hidden text-center py-12">
      <div class="text-5xl mb-4">🎉</div>
      <h2 class="text-2xl font-bold text-mascp-terracotta mb-3">You're on the list!</h2>
      <p class="text-mascp-gray text-lg mb-2">Thank you for reserving your seat at the Pupusa Dinner.</p>
      <p class="text-mascp-gray mb-8">We look forward to celebrating 40 years of sistering with you on August 22.</p>
      <p id="rsvp-paypal-note" class="hidden mt-2 mb-8 text-mascp-gray text-sm">A PayPal tab has opened to complete your donation. Thank you for your generosity!</p>

      <div class="border-t border-gray-200 pt-8">
        <p class="text-sm font-medium text-mascp-dark mb-4">Add to your calendar</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=MASCP+Pupusa+Dinner+%2640th+Anniversary+Celebration&dates=20260822T220000Z%2F20260823T003000Z&details=Please+join+us+as+we+celebrate+40+years+of+sistering+and+hear+from+our+most+recent+delegations+to+El+Salvador.+Slideshow%2C+Salvadoran+music%2C+silent+auction.&location=Aubergine%2C+1226+Williamson+Street%2C+Madison%2C+WI"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block border border-mascp-terracotta text-mascp-terracotta px-6 py-2 text-sm font-medium hover:bg-mascp-terracotta hover:text-white transition"
          >
            Google Calendar
          </a>
          <a
            href="/assets/mascp-pupusa-dinner.ics"
            download
            class="inline-block border border-mascp-terracotta text-mascp-terracotta px-6 py-2 text-sm font-medium hover:bg-mascp-terracotta hover:text-white transition"
          >
            Apple / Outlook (.ics)
          </a>
        </div>
      </div>

      <div class="border-t border-gray-200 pt-8 mt-8">
        <p class="text-sm font-medium text-mascp-dark mb-1">Invite a friend</p>
        <p class="text-xs text-mascp-gray mb-4">This will open your email app with a pre-written invitation.</p>
        <div class="space-y-3 text-left">
          <input
            type="email"
            id="invite-email"
            placeholder="Friend's email address"
            class="w-full px-4 py-4 border border-gray-400 text-lg font-semibold text-mascp-dark focus:outline-none focus:border-mascp-terracotta"
          >
          <textarea
            id="invite-message"
            rows="3"
            placeholder="Add a personal message (optional)"
            class="w-full px-4 py-3 border border-gray-400 text-base focus:outline-none focus:border-mascp-terracotta resize-none"
          ></textarea>
          <button
            id="invite-btn"
            type="button"
            class="w-full bg-mascp-dark text-white px-4 py-3 text-base font-medium hover:opacity-90 transition"
          >
            Send Invitation
          </button>
        </div>
      </div>
    </div>

    <!-- Accessibility info -->
    <div class="mt-10 pt-6 border-t border-gray-200 text-sm text-mascp-gray text-center">
      <p>Wheelchair accessible &bull; Street parking nearby &bull; Bike parking across the street</p>
      <p class="mt-1">Nearby buses: A, B, C and 38</p>
    </div>

  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('rsvp-form');
    var formWrap = document.getElementById('rsvp-form-wrap');
    var success = document.getElementById('rsvp-success');
    var paypalNote = document.getElementById('rsvp-paypal-note');
    var paypalEmail = '{{ paypalEmail }}';

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var donation = parseFloat(document.getElementById('rsvp-donation').value) || 0;

      fetch('/rsvp/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString(),
        credentials: 'same-origin'
      }).then(function () {
        formWrap.classList.add('hidden');
        success.classList.remove('hidden');

        if (donation > 0) {
          paypalNote.classList.remove('hidden');
          var paypalUrl =
            'https://www.paypal.com/donate?business=' +
            encodeURIComponent(paypalEmail) +
            '&amount=' + donation +
            '&currency_code=USD' +
            '&item_name=' + encodeURIComponent('MASCP Pupusa Dinner & 40th Anniversary');
          window.open(paypalUrl, '_blank');
        }
      });
    });
  })();
</script>

<script>
  document.getElementById('invite-btn').addEventListener('click', function () {
    var friendEmail = document.getElementById('invite-email').value.trim();
    if (!friendEmail) {
      document.getElementById('invite-email').focus();
      return;
    }
    var personal = document.getElementById('invite-message').value.trim();
    var subject = 'Join me at the MASCP Pupusa Dinner & 40th Anniversary — August 22';
    var body = (personal ? personal + '\n\n---\n\n' : '') +
      'I just RSVP\'d and wanted to invite you!\n\n' +
      'MASCP Pupusa Dinner and 40th Anniversary Celebration\n' +
      'Saturday, August 22 · 5:00–7:30pm\n' +
      'Aubergine, 1226 Williamson Street, Madison\n\n' +
      'Featuring a 40 Years of Sistering slideshow, Salvadoran music, and silent auction.\n' +
      'Sliding scale suggested donation: $4–$40. Everyone welcome!\n\n' +
      'RSVP here: https://mascp.org/rsvp/\n\n' +
      'View the invitation: https://mascp.org/assets/images/mascp-invitation.png';
    window.location.href = 'mailto:' + encodeURIComponent(friendEmail) +
      '?subject=' + encodeURIComponent(subject) +
      '&body=' + encodeURIComponent(body);
  });
</script>
