---
layout: layouts/base.njk
---

{% if heroImage %}
<section class="hero-section min-h-[350px] md:min-h-[450px]" style="background-image: url('{{ heroImage }}');"></section>
{% else %}
<div class="bg-mascp-dark py-8">
  <h1 class="text-3xl md:text-4xl font-heading text-center text-white">{{ title }}</h1>
</div>
{% endif %}

<article class="max-w-5xl mx-auto px-4 md:px-8 py-8">
  <h1 class="text-3xl font-heading text-mascp-dark mb-8">Newsletter Archive</h1>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
    {% for item in newsletters %}
    <a href="{{ item.href }}" target="_blank" rel="noopener" class="group block">
      <div class="aspect-square overflow-hidden rounded shadow-sm bg-mascp-light">
        <img src="{{ item.img }}" alt="Newsletter {{ item.date }}" class="w-full h-full object-cover group-hover:opacity-80 transition-opacity">
      </div>
      <p class="text-sm text-mascp-gray mt-1 text-center">{{ item.date }}</p>
    </a>
    {% endfor %}
  </div>

  {{ content | safe }}
</article>
