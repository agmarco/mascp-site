---
layout: layouts/base.njk
---

<section class="bg-white">
  <div class="max-w-2xl mx-auto px-4 md:px-8 py-12">

    <!-- Event header -->
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-mascp-terracotta mb-4">Invite a Friend</h1>
      <p class="text-lg text-mascp-gray">{{ eventName }}</p>
      <p class="text-lg font-semibold text-mascp-dark">{{ eventDate }} · {{ eventTime }}</p>
      <p class="text-lg text-mascp-gray">{{ eventVenue }}</p>
      <div class="border-b-2 border-mascp-terracotta w-24 mx-auto mt-6"></div>
    </div>

    <a href="/rsvp/" aria-label="View invitation and RSVP for the MASCP Pupusa Dinner and 40th Anniversary Celebration" class="block mb-8">
      <img
        src="/assets/images/mascp-invitation.png"
        alt="Invitation: MASCP Pupusa Dinner and 40th Anniversary Celebration. Saturday, August 22, 5:00 to 7:30pm. Aubergine, 1226 Williamson Street, Madison. Featuring a 40 Years of Sistering slideshow, Salvadoran music, and silent auction. Sliding scale suggested donation $4 to $40. Everyone welcome. Wheelchair accessible."
        class="w-full h-auto rounded-lg shadow-lg"
      >
    </a>

    <p class="text-mascp-gray text-center mb-8">Enter a friend's email and an optional personal note. We'll send them this invitation with a link to RSVP.</p>

    <div class="space-y-4">
      <div>
        <label for="invite-email" class="block text-base font-bold text-mascp-dark mb-2">Friend's Email <span class="text-mascp-terracotta">*</span></label>
        <input
          type="email"
          id="invite-email"
          placeholder="friend@email.com"
          class="w-full px-4 py-4 border border-gray-400 text-lg font-semibold text-mascp-dark focus:outline-none focus:border-mascp-terracotta"
        >
      </div>

      <div>
        <label for="invite-message" class="block text-base font-bold text-mascp-dark mb-2">Personal Message (optional)</label>
        <textarea
          id="invite-message"
          rows="4"
          placeholder="Add a personal note..."
          class="w-full px-4 py-4 border border-gray-400 text-lg text-mascp-dark focus:outline-none focus:border-mascp-terracotta resize-none"
        ></textarea>
      </div>

      <button
        id="invite-btn"
        type="button"
        class="w-full bg-mascp-terracotta text-white px-4 py-4 text-lg font-medium hover:opacity-90 transition"
      >
        Send Invitation
      </button>

      <p id="invite-status" class="text-center text-sm mt-2"></p>

      <p class="text-center mt-4">
        <a href="/rsvp/" class="text-sm text-mascp-terracotta underline">Haven't RSVP'd yet? Reserve your place first &rarr;</a>
      </p>
    </div>

  </div>
</section>

<script>
  document.getElementById('invite-btn').addEventListener('click', function () {
    var btn = document.getElementById('invite-btn');
    var status = document.getElementById('invite-status');
    var friendEmail = document.getElementById('invite-email').value.trim();
    if (!friendEmail) {
      document.getElementById('invite-email').focus();
      return;
    }
    var personal = document.getElementById('invite-message').value.trim();

    btn.disabled = true;
    status.textContent = 'Sending...';
    status.className = 'text-center text-sm mt-2 text-mascp-gray';

    fetch('/.netlify/functions/send-invite', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        friendEmail: friendEmail,
        personalMessage: personal,
        eventName: 'MASCP Pupusa Dinner and 40th Anniversary Celebration',
        eventDate: 'Saturday, August 22, 2026',
        eventTime: '5:00 – 7:30pm',
        eventVenue: 'Aubergine, 1226 Williamson Street, Madison'
      })
    })
      .then(function (res) { return res.ok ? res.json() : res.json().then(function (d) { throw new Error(d.error || 'Failed to send.'); }); })
      .then(function () {
        status.textContent = 'Invitation sent to ' + friendEmail + '!';
        status.className = 'text-center text-sm mt-2 text-green-700';
        document.getElementById('invite-email').value = '';
        document.getElementById('invite-message').value = '';
      })
      .catch(function (err) {
        status.textContent = err.message || 'Something went wrong. Please try again.';
        status.className = 'text-center text-sm mt-2 text-red-600';
      })
      .finally(function () {
        btn.disabled = false;
      });
  });
</script>
