---
layout: layouts/base.njk
---

{% if heroImage %}
<section class="hero-section min-h-[400px] md:min-h-[500px]" style="background-image: url('{{ heroImage }}');"></section>
{% endif %}

{% if civilWarText %}
<section class="bg-white">
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">
    <h2 class="text-xl md:text-2xl font-heading text-mascp-dark mb-6 pb-2 border-b border-mascp-gray inline-block">THE CIVIL WAR IN EL SALVADOR</h2>
    <p class="text-base md:text-lg leading-relaxed text-mascp-dark">{{ civilWarText }}</p>
  </div>
</section>
{% endif %}

{% if accompanimentText %}
<section class="bg-white">
  <div class="max-w-4xl mx-auto px-4 md:px-8 pb-12">
    <h2 class="text-xl md:text-2xl font-heading text-mascp-dark mb-2 pb-2 border-b border-mascp-gray inline-block">ACCOMPANIMENT -</h2>
    <p class="text-xl md:text-2xl font-heading text-mascp-dark mb-6">Madison and Arcatao become sister cities</p>
    <div class="md:flex md:gap-8">
      <div class="md:w-3/5">
        <div class="prose text-base md:text-lg leading-relaxed text-mascp-dark">
          {{ accompanimentText | markdownify | safe }}
        </div>
      </div>
      {% if videoUrl %}
      <div class="md:w-2/5 mt-6 md:mt-0">
        <div class="bg-mascp-light p-4 text-center">
          {% if videoTitle %}<p class="font-heading font-bold italic text-mascp-dark mb-2">{{ videoTitle }}</p>{% endif %}
          {% if videoCaption %}<p class="text-sm italic text-mascp-gray mb-4">{{ videoCaption }}</p>{% endif %}
          <div class="aspect-video">
            <iframe class="w-full h-full" src="{{ videoUrl }}" title="{{ videoTitle }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% if quoteText %}
<section class="relative bg-cover bg-center min-h-[400px] md:min-h-[500px] flex items-center" style="background-image: url('{{ quoteImage }}');">
  <div class="absolute inset-0 bg-black bg-opacity-40"></div>
  <div class="relative max-w-4xl mx-auto px-4 md:px-8 py-12">
    <blockquote class="text-2xl md:text-4xl lg:text-5xl font-heading text-white text-center leading-relaxed">
      {{ quoteText }}
    </blockquote>
  </div>
</section>
{% endif %}

{% if organizingText %}
<section class="bg-white">
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12">
    <h2 class="text-xl md:text-2xl font-heading text-mascp-dark mb-6 pb-2 border-b border-mascp-gray inline-block">ORGANIZING - After the peace accords</h2>
    <div class="prose text-base md:text-lg leading-relaxed text-mascp-dark">
      {{ organizingText | markdownify | safe }}
    </div>
  </div>
</section>
{% endif %}

<section class="bg-white">
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-12">
    <h2 class="text-2xl md:text-3xl font-heading text-mascp-dark mb-8">Learn More</h2>
    <div class="md:flex md:gap-12 md:items-start">
      <div class="md:w-1/2 mb-8 md:mb-0">
        <div class="h-[300px] md:h-[350px] mb-6">
          <iframe src="https://player.vimeo.com/video/410830490" class="w-full h-full" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
        <h3 class="text-xl md:text-2xl font-heading text-mascp-dark mb-4">MARIA'S STORY</h3>
        <p class="text-base md:text-lg leading-relaxed text-mascp-dark">A documentary portrait of love and survival in El Salvador's civil war.</p>
      </div>
      {% if celebrationsImage %}
      <div class="md:w-1/2">
        <div class="h-[300px] md:h-[350px] mb-6 overflow-hidden rounded-lg">
          <img src="{{ celebrationsImage }}" alt="MASCP 30th Anniversary Celebration in Arcatao" class="w-full h-full object-cover">
        </div>
        <h3 class="text-xl md:text-2xl font-heading text-mascp-dark mb-4">CELEBRATIONS</h3>
        <p class="text-base md:text-lg leading-relaxed text-mascp-dark">MASCP celebrates 30 years of Accompaniment.</p>
      </div>
      {% endif %}
    </div>
  </div>
</section>
